{
  "Name": "WTDeck",
  "Author": "Tomasz Jura",
  "Version": "0.1.0",
  "SDKVersion": 1,
  "Description": "Experimental War Thunder companion for Stream Controller. Dynamic landing gear, flare controls, and flight alert displays.",
  "Category": "WTDeck",
  "CategoryIcon": "assets/category-icon",
  "Icon": "assets/plugin-icon",
  "CodePath": "plugin/index.html",
  "CodePathWin": "plugin/index.html",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "2.9"
  },
  "Actions": [
    {
      "UUID": "com.wtdeck.streamdock.gear",
      "Name": "Landing Gear",
      "Tooltip": "Shows landing gear state and toggles it in War Thunder",
      "Icon": "assets/gear-disabled",
      "PropertyInspectorPath": "plugin/property-inspector.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "assets/gear-disabled",
          "Name": "State",
          "Title": "LANDING\nGEAR",
          "ShowTitle": false,
          "TitleAlignment": "middle",
          "FontSize": "14"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "UUID": "com.wtdeck.streamdock.flares",
      "Name": "Launch Flares",
      "Tooltip": "Shows flare availability and fires flares only in War Thunder",
      "Icon": "assets/flare-unknown",
      "PropertyInspectorPath": "plugin/property-inspector.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "assets/flare-unknown",
          "Name": "State",
          "Title": "FLARES",
          "ShowTitle": true,
          "TitleAlignment": "middle",
          "FontSize": "15"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "UUID": "com.wtdeck.streamdock.flight-alerts",
      "Name": "Over-G Alert",
      "Tooltip": "Shows the current positive G load as a full-size information display tile",
      "Icon": "assets/flight-alerts-panel",
      "PropertyInspectorPath": "plugin/property-inspector.html",
      "Controllers": ["Information"],
      "States": [
        {
          "Image": "assets/flight-alerts-panel",
          "Name": "State",
          "Title": "",
          "ShowTitle": false,
          "TitleAlignment": "middle",
          "FontSize": "12"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    }
  ]
}
