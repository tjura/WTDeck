{
  "schemaVersion": 1,
  "actions": {
    "com.wtdeck.warthunder.gear.toggle": {
      "id": "gear",
      "shortLabel": "GEAR",
      "panelLabel": "LDG GEAR",
      "kind": "toggle",
      "telemetry": {
        "normalizedField": "gearPercent",
        "primaryEndpoint": "state",
        "primaryRawField": "gear, %",
        "fallbackEndpoint": "indicators",
        "fallbackRawFields": [
          "gears_indicator",
          "gears",
          "gears_lamp"
        ]
      },
      "thresholds": {
        "offMax": 5,
        "onMin": 95
      },
      "states": {
        "off": "UP",
        "on": "DOWN",
        "moving": "TRANSIT",
        "unknown": "NO FLIGHT"
      },
      "command": {
        "intent": "landing-gear-toggle",
        "defaultHotkeyLabel": "G",
        "adapter": "companion-http",
        "notes": "Native Stream Dock hotkey settings do not dispatch for custom code actions; use the local WTDeck companion sender."
      }
    }
  }
}
